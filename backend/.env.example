# Sickler's Warriors — Backend Environment Variables (example template)
# Copy to .env and fill in real values.  NEVER commit .env to git.

# Django
DJANGO_ENV=development          # development | test | staging | production
DJANGO_SECRET_KEY=change-me
DEBUG=true

# Database (PostgreSQL)
DB_NAME=sickle_cell
DB_USER=sw_db_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS (comma-separated origins, production only)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ALLOWED_HOSTS (comma-separated, production only)
# ALLOWED_HOSTS=yourdomain.com

# JWT expiry overrides (seconds) — optional
# SIMPLE_JWT_ACCESS_TOKEN_LIFETIME=300
# SIMPLE_JWT_REFRESH_TOKEN_LIFETIME=86400

# AI assistant — optional.
# Default: offline rule_based sandbox (deterministic, no key needed).
# Auto-activation: once GEMINI_API_KEY is set, the assistant switches to
# Google Gemini automatically — AI_PROVIDER is only needed to override
# (pin "gemini" or "rule_based"). A key with AI_PROVIDER unset is enough.
# GEMINI_API_KEY=your-google-ai-studio-key
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_TEMPERATURE=0.30
# GEMINI_MAX_OUTPUT_TOKENS=800
